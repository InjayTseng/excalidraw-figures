   "isDeleted": false,
   "boundElements": null,
   "updated": 1756900000000,
   "link": null,
   "locked": false,
   "text": "Driver 是 Deterministic 的，所以可以、也必須 Deterministic 地測。不要等一整晚的實跑。",
   "fontSize": 14,
   "fontFamily": 1,
   "textAlign": "center",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Driver 是 Deterministic 的，所以可以、也必須 Deterministic 地測。不要等一整晚的實跑。",
   "lineHeight": 1.25,
   "baseline": 14
  }
